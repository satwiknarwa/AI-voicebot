# Copy to .env locally; never commit real credentials.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Required for LLM replies and transcription
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3

# TTS engine: gtts (default, network required) or xtts (local, optional)
VOICE_TTS_ENGINE=gtts
VOICE_LANGUAGE=en

# Used only when VOICE_TTS_ENGINE=xtts. Keep your reference WAV private.
VOICE_REFERENCE_WAV=voice_training/data/reference.wav
VOICE_TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
VOICE_TTS_GPU=false
